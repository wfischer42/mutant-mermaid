{
  "name": "mutant-mermaid",
  "version": "0.2.0",
  "description": "Organic, colorful diagrams from mermaid-like text, in the browser or headless in Node",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid/index.d.ts",
      "default": "./dist/mermaid/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "bin": {
    "mutant-mermaid": "./src/cli.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gallery": "vite gallery",
    "gallery:build": "vite build gallery",
    "render": "tsx src/cli.ts render",
    "snapshots": "tsx scripts/snapshots.ts",
    "mermaid:snapshots": "tsx scripts/mermaid-snapshots.ts",
    "metrics": "tsx scripts/metrics.ts",
    "bench": "tsx scripts/bench.ts",
    "plugin:zip": "mkdir -p dist && git archive -o dist/mutant-mermaid-plugin.zip HEAD .claude-plugin/plugin.json skills src docs package.json",
    "bench:profile":"node --import tsx --cpu-prof --cpu-prof-dir=profiles scripts/bench.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-emoji": "^5.3.2",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@iconify-json/lucide": "^1.2.155",
    "@resvg/resvg-js": "^2.6.2",
    "culori": "^4.0.2",
    "d3-flextree": "^2.1.2",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "elkjs": "^0.12.0",
    "jsdom": "^30.1.3"
  },
  "peerDependencies": {
    "mermaid": "^12.0.0",
    "playwright": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify/types": "^2.0.0",
    "@types/culori": "^4.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.2.0",
    "@types/fontkit": "^2.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "fontkit": "^2.0.4",
    "mermaid": "^12.2.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
